# Merit — environment template. Copy to .env and fill in. NEVER commit a real .env.
#
# ---- Executor key (the on-chain money path) ----
# A funded Monad TESTNET private key. When set, POST /api/settle broadcasts a REAL
# recordReceipt() tx to the deployed MeritReputation contract and only records the receipt
# on err===null. When unset, the API runs in honest "demo" mode (labeled in the UI, never
# claimed on-chain). Fund it: https://faucet.monad.xyz
MERIT_EXECUTOR_KEY=

# ---- Network / RPC ----
# testnet (10143) | mainnet (143). ERC-8004 registries are MAINNET-only; x402 + P256 are on both.
MERIT_NETWORK=testnet
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# ---- Ports ----
MERIT_API_PORT=8130
MERIT_PORT=8120

# ---- Receipt ledger DB (gitignored; defaults to ./data/receipts.db) ----
MERIT_DB_PATH=

# ---- x402 facilitator (defaults to the live Monad facilitator) ----
MERIT_FACILITATOR_URL=https://x402-facilitator.molandak.org

# ---- Envio (indexer) ----
# Get a deploy key at https://envio.dev — used for `envio deploy` (the $5K hosting bounty).
ENVIO_API_TOKEN=
